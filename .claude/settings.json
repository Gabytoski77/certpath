{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opusplan",
  "env": {
    "SUPERPOWERS_DISABLE_TELEMETRY": "1"
  },
  "permissions": {
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
